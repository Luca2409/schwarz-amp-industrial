---
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getCompetencyStaticPaths } from '@/lib/i18n';

export async function getStaticPaths() {
  return getCompetencyStaticPaths('de');
}

const { entry, alternateLocaleUrl } = Astro.props;
const { Content } = await render(entry);
const competenciesUrl = `${getRelativeLocaleUrl('de')}#services`;
---

<BaseLayout
  title={`${entry.data.title} | AMP`}
  description={entry.data.seoDescription}
  alternateLocaleUrl={alternateLocaleUrl}
>
  <Header alternateLocaleUrl={alternateLocaleUrl} />

  <main>
    <section class="detail-hero">
      <div class="detail-hero__inner">
        <div class="detail-back-row">
          <a class="detail-back" href={competenciesUrl}>← Alle Kompetenzen</a>
        </div>
        <div class="eyebrow eyebrow--dark">AMP · Kompetenz</div>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.teaser}</p>
      </div>
    </section>

    <section class="detail-content">
      <article class="markdown-content">
        <Content />
      </article>

      <aside class="detail-sidebar">
        <div class="eyebrow eyebrow--dark">Kontakt</div>
        <h2>Projekt besprechen</h2>
        <p>Sie haben eine konkrete Prüfaufgabe? Sprechen Sie uns an.</p>
        <a class="button button--accent" href="mailto:info@amp-zfp.de">
          Kontakt aufnehmen →
        </a>
      </aside>
    </section>
  </main>

  <Footer />
</BaseLayout>
