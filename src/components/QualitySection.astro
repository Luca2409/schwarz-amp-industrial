---
/** Quality section (`#quality`) with a heading and one highlighted card. */
interface Props {
  /** Small label above the heading. */
  eyebrow: string;
  title: string;
  /** Heading of the card. */
  cardTitle: string;
  /** Text of the card. */
  cardText: string;
  /** Optional link below the card text, e.g. to the certificates page. */
  link?: { label: string; href: string };
}

const { eyebrow, title, cardTitle, cardText, link } = Astro.props;
---

<section class="quality-section" id="quality">
  <div class="section-heading-block">
    <div class="eyebrow">{eyebrow}</div>
    <h2 class="section-heading">{title}</h2>
  </div>

  <div class="quality-card">
    <h3>{cardTitle}</h3>
    <p>{cardText}</p>
    {link && <a class="quality-card__link" href={link.href}>{link.label}</a>}
  </div>
</section>
