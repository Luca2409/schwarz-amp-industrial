---
/** Quality section (`#quality`) with a heading and one highlighted card. */
interface Props {
  /** Small label above the heading. */
  eyebrow: string;
  title: string;
  /** Heading of the card. */
  cardTitle: string;
  /** Text of the card. */
  cardText: string;
}

const { eyebrow, title, cardTitle, cardText } = Astro.props;
---

<section class="quality-section" id="quality">
  <div class="section-heading-block">
    <div class="eyebrow">{eyebrow}</div>
    <h2 class="section-heading">{title}</h2>
  </div>

  <div class="quality-card">
    <h3>{cardTitle}</h3>
    <p>{cardText}</p>
  </div>
</section>
