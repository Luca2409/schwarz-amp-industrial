---
/** Renders schema.org structured data; place it in BaseLayout's `head` slot. */
interface Props {
  /** One or more JSON-LD objects, see `src/lib/structured-data.ts`. */
  data: object | object[];
}

// Escape `<` so content can never close the script tag.
const json = JSON.stringify(Astro.props.data).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={json} />
