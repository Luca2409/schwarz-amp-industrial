---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Full-width image below the hero with an optional caption. The image is cropped with `object-fit: cover`. */
interface Props {
  /** Image from `src/assets/`. */
  src: ImageMetadata;
  /** Alt text of the image. */
  alt: string;
  /** Small label in the caption. */
  eyebrow?: string;
  /** Caption text; the caption is hidden if neither `eyebrow` nor `caption` is set. */
  caption?: string;
}

const {
  src,
  alt,
  eyebrow,
  caption,
} = Astro.props;
---

<figure class="image-showcase">
  <Image
    class="image-showcase__image"
    src={src}
    alt={alt}
    widths={[640, 960, 1440]}
    sizes="(min-width: 1440px) 1300px, 100vw"
  />

  {(eyebrow || caption) && (
    <figcaption class="image-showcase__caption">
      {eyebrow && (
        <span class="image-showcase__eyebrow">{eyebrow}</span>
      )}

      {caption && (
        <span class="image-showcase__text">{caption}</span>
      )}
    </figcaption>
  )}
</figure>
