---
import type { Lang } from '@/i18n/ui';
import { getHomeAnchor, getLocalizedPath, useTranslations } from '@/i18n/utils';
import { getEntryPath, getLegalPages } from '@/lib/content';
import { site } from '@/site';

/** Site footer with navigation, related companies, contact data and links to the legal pages of `lang`. */
interface Props {
  /** Language of the current page. */
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const legalLinks = (await getLegalPages(lang)).map((entry) => ({
  label: entry.data.title,
  href: getEntryPath(entry),
}));
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <b>AMP</b>
      <span>{t('brand.subtitle')}</span>
    </div>

    <nav class="site-footer__navigation" aria-label={t('footer.navLabel')}>
      <a href={getHomeAnchor(lang, 'about')}>{t('nav.about')}</a>
      <a href={getHomeAnchor(lang, 'services')}>{t('nav.competencies')}</a>
      <a href={getHomeAnchor(lang, 'quality')}>{t('nav.quality')}</a>
      <a href={getLocalizedPath(lang, 'certificates')}>{t('nav.certificates')}</a>
      <a href={getLocalizedPath(lang, 'contact')}>{t('nav.contact')}</a>
    </nav>

    <nav class="site-footer__related" aria-labelledby={`footer-related-heading-${lang}`}>
      <span class="site-footer__heading" id={`footer-related-heading-${lang}`}>{t('footer.relatedLabel')}</span>
      {site.relatedCompanies.map((company) => (
        <a href={company.url}>{company.name}</a>
      ))}
    </nav>

    <div class="site-footer__contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.phone.href}>{site.phone.display}</a>
    </div>
  </div>
  <div class="site-footer__bottom">
    <span>{site.company}</span>
    {legalLinks.length > 0 ? (
      <nav class="site-footer__legal" aria-label={t('footer.legalLabel')}>
        {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    ) : (
      <span>{t('footer.tagline')}</span>
    )}
  </div>
</footer>
