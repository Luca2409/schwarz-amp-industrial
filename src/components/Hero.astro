---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Full-screen hero: the image fills the first screen below the header, the text sits on it
 * (left, on a dark gradient), and the `facts` slot (key facts card) is centered at the bottom.
 *
 * First section of the home page: headline, intro text and two buttons on the left,
 * the main image on the right (stacked on screens up to 900px).
 */
interface Props {
  /** Small label above the headline. */
  eyebrow: string;
  /** First part of the headline. */
  titlePrefix: string;
  /** Second part of the headline, visually highlighted. */
  titleHighlight: string;
  /** Intro paragraph. */
  text: string;
  /** Hero image from `src/assets/`; loaded eagerly as it's the largest element on the page. */
  image: ImageMetadata;
  /** Alt text of the image. */
  imageLabel: string;
  /** Label of the primary (yellow) button. */
  primaryLabel: string;
  /** Target of the primary button, e.g. `#services`. */
  primaryHref: string;
  /** Label of the secondary button. */
  secondaryLabel: string;
  /** Target of the secondary button; the home page passes the contact page. */
  secondaryHref: string;
}

const props = Astro.props;
---

<section class="hero">
  <div class="hero__copy">
    <div class="hero__heading">
      <div class="eyebrow">{props.eyebrow}</div>

      <h1 class="hero__title">
        {props.titlePrefix}
        <span>{props.titleHighlight}</span>
      </h1>
    </div>

    <div class="hero__support">
      <p class="hero__text">{props.text}</p>

      <div class="hero__actions">
        <a class="button button--primary" href={props.primaryHref}>
          {props.primaryLabel}
          <span>→</span>
        </a>

        <a class="button button--secondary" href={props.secondaryHref}>
          {props.secondaryLabel}
        </a>
      </div>
    </div>
  </div>

  <div class="hero__visual">
    <Image
      class="hero__image"
      src={props.image}
      alt={props.imageLabel}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  {Astro.slots.has('facts') && (
    <div class="hero__facts">
      <slot name="facts" />
    </div>
  )}
</section>
