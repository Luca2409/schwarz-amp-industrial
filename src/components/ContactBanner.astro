---
interface Props {
  title: string;
  label: string;
  href: string;
}

const { title, label, href } = Astro.props;
---

<section class="contact-banner" id="contact">
  <div class="contact-banner__copy">
    <h2>{title}</h2>
  </div>
  <a href={href}>{label} <span aria-hidden="true">→</span></a>
</section>
