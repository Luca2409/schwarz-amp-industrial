---
import { getCompetencyUrl } from '@/lib/i18n';

interface Props {
  id: string;
  number: string;
  title: string;
  teaser: string;
}

const { id, number, title, teaser } = Astro.props;
const locale = Astro.currentLocale === 'en' ? 'en' : 'de';
const slug = id.replace(new RegExp(`^${locale}/`), '');
const href = getCompetencyUrl(locale, slug);
---

<a class="competency-row" href={href}>
  <div class="competency-row__number">{number}</div>
  <h3 class="competency-row__title">{title}</h3>
  <p class="competency-row__text">{teaser}</p>
  <b class="competency-row__arrow" aria-hidden="true">→</b>
</a>
