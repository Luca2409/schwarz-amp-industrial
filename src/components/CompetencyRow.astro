---
/** One linked row in the competencies list. */
interface Props {
  /** Localized URL of the competency page, see `getEntryPath`. */
  href: string;
  /** Display number, e.g. `"01"`. */
  number: string;
  title: string;
  /** Short description next to the title. */
  teaser: string;
}

const { href, number, title, teaser } = Astro.props;
---

<a class="competency-row" href={href}>
  <div class="competency-row__number">{number}</div>
  <h3 class="competency-row__title">{title}</h3>
  <p class="competency-row__text">{teaser}</p>
  <b class="competency-row__arrow" aria-hidden="true">→</b>
</a>
