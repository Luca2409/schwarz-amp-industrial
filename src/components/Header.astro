---
import LanguagePicker from './LanguagePicker.astro';
import type { Lang } from '@/i18n/ui';
import { getHomeAnchor, getLocalizedPath, useTranslations, type Alternate } from '@/i18n/utils';

/** Site header with navigation and language picker. */
interface Props {
  /** Language of the current page. */
  lang: Lang;
  /** Translations of the current page, passed on to the language picker. */
  alternates: Alternate[];
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);

const navigation = [
  { label: t('nav.about'), href: getHomeAnchor(lang, 'about') },
  { label: t('nav.competencies'), href: getHomeAnchor(lang, 'services') },
  { label: t('nav.quality'), href: getHomeAnchor(lang, 'quality') },
  { label: t('nav.contact'), href: getLocalizedPath(lang, 'contact') },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={getLocalizedPath(lang)} aria-label={t('brand.homeLabel')}>
      <span class="brand__name">AMP</span>
      <span class="brand__line"></span>
      <span class="brand__subtitle">{t('brand.subtitle')}</span>
    </a>

    <nav class="main-navigation" aria-label={t('nav.mainLabel')}>
      {navigation.map((item) => (
        <a class="main-navigation__link" href={item.href}>{item.label}</a>
      ))}

      <LanguagePicker lang={lang} alternates={alternates} />

      <a class="main-navigation__cta" href={getLocalizedPath(lang, 'contact')}>{t('nav.cta')}</a>
    </nav>

    <details class="mobile-navigation">
      <summary><span>{t('nav.menu')}</span><i aria-hidden="true"></i></summary>
      <nav aria-label={t('nav.mobileLabel')}>
        {navigation.map((item) => (
          <a class="mobile-navigation__link" href={item.href}>{item.label}<span aria-hidden="true">→</span></a>
        ))}

        <div class="mobile-navigation__languages">
          <span>{t('language.label')}</span>
          <LanguagePicker lang={lang} alternates={alternates} />
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  // Mobile menu (<details>): closes after a link is clicked and on Escape, returning focus to the toggle.
  document.querySelectorAll<HTMLDetailsElement>('.mobile-navigation').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector<HTMLElement>('summary')?.focus();
      }
    });
  });
</script>
