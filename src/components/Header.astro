---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  alternateLocaleUrl?: string;
  preserveHashOnLanguageSwitch?: boolean;
}

const locale = Astro.currentLocale === 'en' ? 'en' : 'de';
const home = getRelativeLocaleUrl(locale);
const {
  alternateLocaleUrl,
  preserveHashOnLanguageSwitch = false,
} = Astro.props;
const copy = locale === 'en'
  ? {
      subtitle: 'Non-Destructive Testing',
      homeLabel: 'AMP home page',
      navigationLabel: 'Main navigation',
      mobileNavigationLabel: 'Mobile main navigation',
      menu: 'Menu',
      cta: 'Discuss your project',
      navigation: [
        { label: 'Expertise', hash: 'about' },
        { label: 'Services', hash: 'services' },
        { label: 'Quality', hash: 'quality' },
        { label: 'Contact', hash: 'contact' },
      ],
    }
  : {
      subtitle: 'Zerstörungsfreie Werkstoffprüfung',
      homeLabel: 'AMP Startseite',
      navigationLabel: 'Hauptnavigation',
      mobileNavigationLabel: 'Mobile Hauptnavigation',
      menu: 'Menü',
      cta: 'Projekt anfragen',
      navigation: [
        { label: 'Know-how', hash: 'about' },
        { label: 'Kompetenzen', hash: 'services' },
        { label: 'Qualität', hash: 'quality' },
        { label: 'Kontakt', hash: 'contact' },
      ],
    };
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={home} aria-label={copy.homeLabel}>
      <span class="brand__name">AMP</span>
      <span class="brand__line"></span>
      <span class="brand__subtitle">{copy.subtitle}</span>
    </a>

    <nav class="main-navigation" aria-label={copy.navigationLabel}>
      {copy.navigation.map((item) => (
        <a class="main-navigation__link" href={`${home}#${item.hash}`}>{item.label}</a>
      ))}

      <LanguageSwitcher
        locale={locale}
        alternateLocaleUrl={alternateLocaleUrl}
        preserveHash={preserveHashOnLanguageSwitch}
        variant="desktop"
      />
      <a class="main-navigation__cta" href={`${home}#contact`}>{copy.cta}</a>
    </nav>

    <details class="mobile-navigation">
      <summary><span>{copy.menu}</span><i aria-hidden="true"></i></summary>
      <nav aria-label={copy.mobileNavigationLabel}>
        {copy.navigation.map((item) => (
          <a href={`${home}#${item.hash}`}>{item.label}<span aria-hidden="true">→</span></a>
        ))}
        <LanguageSwitcher
          locale={locale}
          alternateLocaleUrl={alternateLocaleUrl}
          preserveHash={preserveHashOnLanguageSwitch}
          variant="mobile"
        />
      </nav>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-navigation').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector<HTMLElement>('summary')?.focus();
      }
    });
  });
</script>
