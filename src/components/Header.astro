---
const navigation = [
  { label: 'Know-how', href: '/#about' },
  { label: 'Kompetenzen', href: '/#services' },
  { label: 'Qualität', href: '/#quality' },
  { label: 'Kontakt', href: '/#contact' },
];
---

<header class="site-header">
  <a class="brand" href={`${import.meta.env.BASE_URL}`} aria-label="AMP Startseite">
    <span class="brand__name">AMP</span>
    <span class="brand__line"></span>
    <span class="brand__subtitle">Zerstörungsfreie Werkstoffprüfung</span>
  </a>

  <nav class="main-navigation" aria-label="Hauptnavigation">
    {navigation.map((item) => (
      <a class="main-navigation__link" href={`${import.meta.env.BASE_URL}${item.href}`}>{item.label}</a>
    ))}

    <a class="main-navigation__cta" href={`${import.meta.env.BASE_URL}/#contact`}>Projekt anfragen</a>
  </nav>
</header>
