---
import TopoLines from '@/assets/topo-lines.svg';

/**
 * "Know-how" section (`#about`) on a contour-line background (generated by
 * scripts/generate-topo-lines.py). The default slot holds the rendered Markdown body of
 * home.md, whose first paragraph is shown as a lead; the `media` slot takes an image below.
 */
interface Props {
  /** Small label above the heading. */
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="about-section" id="about">
  <TopoLines class="about-section__topo" aria-hidden="true" />

  <div class="about-section__inner">
    <div class="section-heading-block">
      <div class="eyebrow">{eyebrow}</div>
      <h2 class="section-heading">{title}</h2>
    </div>

    <div class="about-section__content markdown-content">
      <slot />
    </div>

    {Astro.slots.has('media') && (
      <div class="about-section__media">
        <slot name="media" />
      </div>
    )}
  </div>
</section>
