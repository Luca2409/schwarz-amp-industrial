---
/** "Know-how" section (`#about`); the default slot holds the rendered Markdown body of home.md. */
interface Props {
  /** Small label above the heading. */
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="about-section" id="about">
  <div class="about-section__inner">
    <div class="section-heading-block">
      <div class="eyebrow eyebrow--dark">{eyebrow}</div>
      <h2 class="section-heading">{title}</h2>
    </div>

    <div class="about-section__content markdown-content">
      <slot />
    </div>
  </div>
</section>
