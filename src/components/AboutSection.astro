---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="about-section" id="about">
  <div>
    <div class="eyebrow">{eyebrow}</div>
    <h2 class="section-heading">{title}</h2>
  </div>

  <div class="about-section__content markdown-content">
    <slot />
  </div>
</section>
