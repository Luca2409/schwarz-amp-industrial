---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'AMP – Zerstörungsfreie Werkstoffprüfung',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
